import { Button, CheckBox, SpinBox, LineEdit, TextEdit, GroupBox, Palette } from "std-widgets.slint";

import { SidebarButton, BasicPage, NetworkSizePage, TimeoutPage, AdditionalOptionsPage, InExAppPage, ScalingPage, AboutPage } from "components/sidebar.slint";

component SettingsSidebar inherits VerticalLayout {
    in property <int> current-page: 0;
    callback navigate(int);

    padding: 4px;
    spacing: 2px;
    alignment: start;

    SidebarButton { label: "Basic"; active: current-page == 0; clicked => { root.navigate(0); } }
    SidebarButton { label: "Network Size"; active: current-page == 1; clicked => { root.navigate(1); } }
    SidebarButton { label: "Timeout"; active: current-page == 2; clicked => { root.navigate(2); } }
    SidebarButton { label: "Additional Options"; active: current-page == 3; clicked => { root.navigate(3); } }
    SidebarButton { label: "In/Ex App"; active: current-page == 4; clicked => { root.navigate(4); } }
    SidebarButton { label: "Scaling"; active: current-page == 6; clicked => { root.navigate(6); } }
    SidebarButton { label: "About"; active: current-page == 7; clicked => { root.navigate(7); } }
}

export component AppWindow inherits Window {
    title: "Porda AI Settings";
    min-width: 820px;
    min-height: 540px;
    preferred-width: root.is-solid-color ? 1000px : 820px;
    preferred-height: root.is-solid-color ? 800px : 540px;

    in property <bool> is-active: false;
    in-out property <bool> is-blur: true;
    in-out property <bool> is-bg-color: false;
    in-out property <bool> is-solid-color: false;
    in-out property <int> accuracy: 25;
    in-out property <int> network-width: 544;
    in-out property <int> network-height: 320;
    in-out property <int> active-timeout: 65;
    in-out property <string> engine: "CPU Engine";
    in-out property <bool> is-detect-male: false;
    in-out property <bool> is-detect-female: true;
    in-out property <bool> is-all-windows: false;
    in-out property <bool> is-include-window: true;
    in-out property <bool> is-exclude-window: false;
    in-out property <string> include-windows: "";
    in-out property <string> exclude-windows: "";
    in-out property <bool> auto-startup: true;
    in-out property <bool> is-priority-realtime: false;
    in-out property <bool> is-allow-max-cpu-limit: false;
    in-out property <int> max-cpu-limit: 90;
    in-out property <string> toggle-key: "Meta+Shift+P";
    in property <string> hotkey-display: "Meta + Shift + P";
    in property <string> hotkey-status: "Shortcut managed by desktop environment";
    in property <bool> hotkey-available: true;
    in property <bool> hotkey-configuring: false;
    in property <bool> is-linux: true;
    in property <float> cpu-usage: 0.0;
    in property <string> detection-state: "Sleep";
    in-out property <int> current-page: 0;
    in-out property <int> cover-r: 0;
    in-out property <int> cover-g: 0;
    in-out property <int> cover-b: 255;
    in-out property <color> cover-color: #0000ff;
    in-out property <length> wheel-dot-x: 80px;
    in-out property <length> wheel-dot-y: 80px;

    callback activate();
    callback deactivate();
    callback toggle-activation();
    callback save();
    callback apply();
    callback restore-defaults();
    callback refresh-hotkeys();
    callback configure-hotkey();
    callback terminate();
    callback navigate(int);

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // --- LEFT SIDEBAR PANEL ---
        Rectangle {
            width: 180px;
            background: Palette.alternate-background;
            border-radius: 6px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                alignment: start;

                // Header Block
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Porda AI";
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Palette.border; } // Subtle divider

                SettingsSidebar {
                    current-page: root.current-page;
                    navigate(page) => { root.current-page = page; root.navigate(page); }
                }
            }
        }

        // --- RIGHT MAIN CONTENT PANEL ---
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            // Content Area
            Rectangle {
                vertical-stretch: 1;
                background: Palette.alternate-background;
                border-radius: 6px;
                padding: 12px;

                VerticalLayout {
                    alignment: start; // Prevents vertical stretching of inner pages

                    if root.current-page == 0: BasicPage {
                        is-blur <=> root.is-blur;
                        is-bg-color <=> root.is-bg-color;
                        is-solid-color <=> root.is-solid-color;
                        accuracy <=> root.accuracy;
                        is-detect-male <=> root.is-detect-male;
                        is-detect-female <=> root.is-detect-female;
                        cover-r <=> root.cover-r;
                        cover-g <=> root.cover-g;
                        cover-b <=> root.cover-b;
                        cover-color <=> root.cover-color;
                        wheel-dot-x <=> root.wheel-dot-x;
                        wheel-dot-y <=> root.wheel-dot-y;
                    }

                    if root.current-page == 1: NetworkSizePage {
                        network-width <=> root.network-width;
                        network-height <=> root.network-height;
                    }

                    if root.current-page == 2: TimeoutPage {
                        active-timeout <=> root.active-timeout;
                    }

                    if root.current-page == 3: AdditionalOptionsPage {
                        auto-startup <=> root.auto-startup;
                        is-priority-realtime <=> root.is-priority-realtime;
                        toggle-key <=> root.toggle-key;
                        hotkey-display: root.hotkey-display;
                        hotkey-status: root.hotkey-status;
                        hotkey-available: root.hotkey-available;
                        hotkey-configuring: root.hotkey-configuring;
                        is-linux: root.is-linux;
                        configure-hotkey => { root.configure-hotkey(); }
                        refresh-hotkeys => { root.refresh-hotkeys(); }
                    }

                    if root.current-page == 4: InExAppPage {
                        is-all-windows <=> root.is-all-windows;
                        is-include-window <=> root.is-include-window;
                        is-exclude-window <=> root.is-exclude-window;
                        include-windows <=> root.include-windows;
                        exclude-windows <=> root.exclude-windows;
                    }


                    if root.current-page == 6: ScalingPage {
                        is-allow-max-cpu-limit <=> root.is-allow-max-cpu-limit;
                        max-cpu-limit <=> root.max-cpu-limit;
                    }

                    if root.current-page == 7: AboutPage {}
                }
            }

            // Bottom Action Toolbar (Slimmed down to 1 row)
            Rectangle {
                height: 44px;
                background: Palette.alternate-background;
                border-radius: 6px;
                padding-left: 10px;
                padding-right: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    Button {
                        text: root.is-active ? "Deactivate" : "Activate";
                        clicked => { root.toggle-activation(); }
                    }
                    Button {
                        text: "Default";
                        clicked => { root.restore-defaults(); }
                    }
                    Button {
                        text: "Apply";
                        clicked => { root.apply(); }
                    }
                }
            }
        }
    }
}
