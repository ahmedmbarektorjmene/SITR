import { Button, CheckBox, RadioGroup, RadioButton, SpinBox, LineEdit, TextEdit, GroupBox, Palette } from "std-widgets.slint";


export component SidebarButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 32px; // Reduced height
    background: active ? Palette.accent-background : transparent;
    border-radius: 4px;
    width: 100%;

    HorizontalLayout {
        padding-left: 10px;
        alignment: start;
        Text {
            text: root.label;
            color: active ? Palette.accent-foreground : Palette.foreground;
            vertical-alignment: center;
            font-size: 13px;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component BasicPage inherits VerticalLayout {
    in-out property <bool> is-blur: true;
    in-out property <bool> is-bg-color: false;
    in-out property <bool> is-solid-color: false;
    in-out property <int> accuracy: 25;
    in-out property <bool> is-detect-male: false;
    in-out property <bool> is-detect-female: true;
    in-out property <int> cover-r: 0;
    in-out property <int> cover-g: 0;
    in-out property <int> cover-b: 255;
    in-out property <color> cover-color: #0000ff;
    in-out property <length> wheel-dot-x: 80px;
    in-out property <length> wheel-dot-y: 80px;

    spacing: 12px; // Tightened vertical layout gaps
    alignment: start; // Prevents page elements from stretching vertically

    GroupBox {
        title: "Cover Mode";
        RadioGroup {
            orientation: horizontal;
            RadioButton {
                text: "Blur";
                checked: root.is-blur;
                toggled => { root.is-blur = true; root.is-bg-color = false; root.is-solid-color = false; }
            }
            RadioButton {
                text: "Background Color";
                checked: root.is-bg-color;
                toggled => { root.is-bg-color = true; root.is-blur = false; root.is-solid-color = false; }
            }
            RadioButton {
                text: "Solid Color";
                checked: root.is-solid-color;
                toggled => { root.is-solid-color = true; root.is-blur = false; root.is-bg-color = false; }
            }
        }
    }

    if root.is-solid-color: GroupBox {
        title: "Solid Color";
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.cover-color;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                }
                Text { text: "Preview"; vertical-alignment: center; font-size: 13px; }
                Text {
                    text: "(" + root.cover-r + ", " + root.cover-g + ", " + root.cover-b + ")";
                    vertical-alignment: center;
                    font-size: 11px;
                    color: Palette.foreground.transparentize(30%);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: "R:"; vertical-alignment: center; font-size: 13px; width: 16px; }
                SpinBox {
                    width: 80px;
                    value: root.cover-r;
                    minimum: 0;
                    maximum: 255;
                    edited => { root.cover-r = self.value; root.cover-color = rgb(root.cover-r, root.cover-g, root.cover-b); }
                }
                Text { text: "G:"; vertical-alignment: center; font-size: 13px; width: 16px; }
                SpinBox {
                    width: 80px;
                    value: root.cover-g;
                    minimum: 0;
                    maximum: 255;
                    edited => { root.cover-g = self.value; root.cover-color = rgb(root.cover-r, root.cover-g, root.cover-b); }
                }
                Text { text: "B:"; vertical-alignment: center; font-size: 13px; width: 16px; }
                SpinBox {
                    width: 80px;
                    value: root.cover-b;
                    minimum: 0;
                    maximum: 255;
                    edited => { root.cover-b = self.value; root.cover-color = rgb(root.cover-r, root.cover-g, root.cover-b); }
                }
            }
            // Color wheel – hue strip + preset colors
            VerticalLayout {
                spacing: 6px;
                Text { text: "Color Wheel / Presets"; font-size: 11px; color: Palette.foreground.transparentize(40%); }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    // Preset colors
                    Rectangle { width: 28px; height: 28px; background: #ff0000; border-radius: 4px; TouchArea { clicked => { root.cover-r = 255; root.cover-g = 0; root.cover-b = 0; root.cover-color = #ff0000; } } }
                    Rectangle { width: 28px; height: 28px; background: #00ff00; border-radius: 4px; TouchArea { clicked => { root.cover-r = 0; root.cover-g = 255; root.cover-b = 0; root.cover-color = #00ff00; } } }
                    Rectangle { width: 28px; height: 28px; background: #0000ff; border-radius: 4px; TouchArea { clicked => { root.cover-r = 0; root.cover-g = 0; root.cover-b = 255; root.cover-color = #0000ff; } } }
                    Rectangle { width: 28px; height: 28px; background: #ffff00; border-radius: 4px; TouchArea { clicked => { root.cover-r = 255; root.cover-g = 255; root.cover-b = 0; root.cover-color = #ffff00; } } }
                    Rectangle { width: 28px; height: 28px; background: #ff00ff; border-radius: 4px; TouchArea { clicked => { root.cover-r = 255; root.cover-g = 0; root.cover-b = 255; root.cover-color = #ff00ff; } } }
                    Rectangle { width: 28px; height: 28px; background: #00ffff; border-radius: 4px; TouchArea { clicked => { root.cover-r = 0; root.cover-g = 255; root.cover-b = 255; root.cover-color = #00ffff; } } }
                    Rectangle { width: 28px; height: 28px; background: #ffffff; border-radius: 4px; border-width: 1px; border-color: Palette.border; TouchArea { clicked => { root.cover-r = 255; root.cover-g = 255; root.cover-b = 255; root.cover-color = #ffffff; } } }
                    Rectangle { width: 28px; height: 28px; background: #000000; border-radius: 4px; TouchArea { clicked => { root.cover-r = 0; root.cover-g = 0; root.cover-b = 0; root.cover-color = #000000; } } }
                }

                // Real circular color wheel via conic gradient
                Rectangle {
                    width: 160px;
                    height: 160px;
                    border-radius: 80px;
                    border-width: 1px;
                    border-color: Palette.border;
                    clip: true;
                    background: @conic-gradient(red 0deg, yellow 60deg, lime 120deg, cyan 180deg, blue 240deg, magenta 300deg, red 360deg);
                    Rectangle {
                        width: 10px; height: 10px;
                        x: root.wheel-dot-x - self.width / 2;
                        y: root.wheel-dot-y - self.height / 2;
                        background: root.cover-color;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #ffffff;
                    }
                    wheel-touch := TouchArea {
                        width: 100%; height: 100%;
                        moved => {
                            if (self.pressed) {
                                root.wheel-dot-x = self.mouse-x;
                                root.wheel-dot-y = self.mouse-y;
                                if (self.width > 0) {
                                    if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 60) {
                                        root.cover-r = 255;
                                        root.cover-g = Math.round((Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180) / 60 * 255);
                                        root.cover-b = 0;
                                    } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 120) {
                                        root.cover-r = Math.round((120 - (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180)) / 60 * 255);
                                        root.cover-g = 255;
                                        root.cover-b = 0;
                                    } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 180) {
                                        root.cover-r = 0;
                                        root.cover-g = 255;
                                        root.cover-b = Math.round((Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 - 120) / 60 * 255);
                                    } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 240) {
                                        root.cover-r = 0;
                                        root.cover-g = Math.round((240 - (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180)) / 60 * 255);
                                        root.cover-b = 255;
                                    } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 300) {
                                        root.cover-r = Math.round((Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 - 240) / 60 * 255);
                                        root.cover-g = 0;
                                        root.cover-b = 255;
                                    } else {
                                        root.cover-r = 255;
                                        root.cover-g = 0;
                                        root.cover-b = Math.round((360 - (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180)) / 60 * 255);
                                    }
                                    root.cover-color = rgb(root.cover-r, root.cover-g, root.cover-b);
                                }
                            }
                        }
                        clicked => {
                            root.wheel-dot-x = self.mouse-x;
                            root.wheel-dot-y = self.mouse-y;
                            if (self.width > 0) {
                                if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 60) {
                                    root.cover-r = 255;
                                    root.cover-g = Math.round((Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180) / 60 * 255);
                                    root.cover-b = 0;
                                } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 120) {
                                    root.cover-r = Math.round((120 - (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180)) / 60 * 255);
                                    root.cover-g = 255;
                                    root.cover-b = 0;
                                } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 180) {
                                    root.cover-r = 0;
                                    root.cover-g = 255;
                                    root.cover-b = Math.round((Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 - 120) / 60 * 255);
                                } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 240) {
                                    root.cover-r = 0;
                                    root.cover-g = Math.round((240 - (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180)) / 60 * 255);
                                    root.cover-b = 255;
                                } else if (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 < 300) {
                                    root.cover-r = Math.round((Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180 - 240) / 60 * 255);
                                    root.cover-g = 0;
                                    root.cover-b = 255;
                                } else {
                                    root.cover-r = 255;
                                    root.cover-g = 0;
                                    root.cover-b = Math.round((360 - (Math.atan2((self.mouse-y - self.height / 2) / 1px, (self.mouse-x - self.width / 2) / 1px) / 1deg + 180)) / 60 * 255);
                                }
                                root.cover-color = rgb(root.cover-r, root.cover-g, root.cover-b);
                            }
                        }
                    }
                }
                // linear hue strip as secondary picker
                Rectangle {
                    height: 14px;
                    width: 100%;
                    border-radius: 4px;
                    clip: true;
                    Image {
                        source: @image-url("../assets/wheel.png");
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                    strip-touch := TouchArea {
                        clicked => {
                            if (strip-touch.width > 0) {
                                if (strip-touch.mouse-x / strip-touch.width * 360 < 60) {
                                    root.cover-r = 255;
                                    root.cover-g = Math.round(strip-touch.mouse-x / strip-touch.width * 360 / 60 * 255);
                                    root.cover-b = 0;
                                } else if (strip-touch.mouse-x / strip-touch.width * 360 < 120) {
                                    root.cover-r = Math.round((120 - strip-touch.mouse-x / strip-touch.width * 360) / 60 * 255);
                                    root.cover-g = 255;
                                    root.cover-b = 0;
                                } else if (strip-touch.mouse-x / strip-touch.width * 360 < 180) {
                                    root.cover-r = 0;
                                    root.cover-g = 255;
                                    root.cover-b = Math.round((strip-touch.mouse-x / strip-touch.width * 360 - 120) / 60 * 255);
                                } else if (strip-touch.mouse-x / strip-touch.width * 360 < 240) {
                                    root.cover-r = 0;
                                    root.cover-g = Math.round((240 - strip-touch.mouse-x / strip-touch.width * 360) / 60 * 255);
                                    root.cover-b = 255;
                                } else if (strip-touch.mouse-x / strip-touch.width * 360 < 300) {
                                    root.cover-r = Math.round((strip-touch.mouse-x / strip-touch.width * 360 - 240) / 60 * 255);
                                    root.cover-g = 0;
                                    root.cover-b = 255;
                                } else {
                                    root.cover-r = 255;
                                    root.cover-g = 0;
                                    root.cover-b = Math.round((360 - strip-touch.mouse-x / strip-touch.width * 360) / 60 * 255);
                                }
                                root.cover-color = rgb(root.cover-r, root.cover-g, root.cover-b);
                            }
                        }
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Detection";
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text { text: "Confidence (1-99):"; vertical-alignment: center; font-size: 13px; }
                SpinBox {
                    width: 110px; // Capped width stops "thick" textboxes
                    value: root.accuracy;
                    minimum: 1;
                    maximum: 99;
                    edited => { root.accuracy = self.value; }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                alignment: start;
                CheckBox {
                    text: "Detect Male";
                    checked: root.is-detect-male;
                    toggled => { root.is-detect-male = self.checked; }
                }
                CheckBox {
                    text: "Detect Female";
                    checked: root.is-detect-female;
                    toggled => { root.is-detect-female = self.checked; }
                }
            }
        }
    }
}

export component NetworkSizePage inherits VerticalLayout {
    in-out property <int> network-width: 544;
    in-out property <int> network-height: 320;

    spacing: 12px;
    alignment: start;

    GroupBox {
        title: "Network Dimensions";
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text { text: "Width (multiple of 32):"; vertical-alignment: center; font-size: 13px; }
                SpinBox {
                    width: 120px;
                    value: root.network-width;
                    minimum: 160;
                    maximum: 608;
                    edited => { root.network-width = self.value; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text { text: "Height (multiple of 32):"; vertical-alignment: center; font-size: 13px; }
                SpinBox {
                    width: 120px;
                    value: root.network-height;
                    minimum: 160;
                    maximum: 480;
                    edited => { root.network-height = self.value; }
                }
            }
            Text {
                text: "Recommended: 544 x 320";
                font-size: 11px;
                color: Palette.foreground.transparentize(40%);
            }
        }
    }
}

export component TimeoutPage inherits VerticalLayout {
    in-out property <int> active-timeout: 65;

    spacing: 12px;
    alignment: start;

    GroupBox {
        title: "Detection Timing";
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text { text: "Active timeout (ms):"; vertical-alignment: center; font-size: 13px; }
                SpinBox {
                    width: 120px;
                    value: root.active-timeout;
                    minimum: 16;
                    maximum: 1000;
                    edited => { root.active-timeout = self.value; }
                }
            }
            Text {
                text: "No automatic timeout – detection stays active until Deactivate. (nms=0.1)";
                font-size: 11px;
                color: Palette.foreground.transparentize(40%);
                wrap: word-wrap;
            }
        }
    }
}

export component AdditionalOptionsPage inherits VerticalLayout {
    in-out property <bool> auto-startup: true;
    in-out property <bool> is-priority-realtime: false;
    in-out property <string> toggle-key: "Meta+Shift+P";
    // Linux/Wayland portal-authoritative display
    in property <string> hotkey-display: "Meta + Shift + P";
    in property <string> hotkey-status: "Shortcut managed by desktop environment";
    in property <bool> hotkey-available: true;
    in property <bool> hotkey-configuring: false;
    in property <bool> is-linux: true;
    callback configure-hotkey;
    callback refresh-hotkeys;

    spacing: 12px;
    alignment: start;

    GroupBox {
        title: "Startup";
        VerticalLayout {
            spacing: 8px;
            CheckBox {
                text: "Auto-start with system";
                checked: root.auto-startup;
                toggled => { root.auto-startup = self.checked; }
            }

            CheckBox {
                text: "Real-time process priority";
                checked: root.is-priority-realtime;
                toggled => { root.is-priority-realtime = self.checked; }
            }
        }
    }

    GroupBox {
        title: "Global Hotkey";
        VerticalLayout {
            spacing: 10px;
            Text {
                text: "Toggle Detection";
                font-size: 12px;
                font-weight: 600;
            }
            // Linux/Wayland: portal-managed read-only display
            if root.is-linux: VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: 28px;
                    background: Palette.alternate-background;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: root.hotkey-configuring ? "Configuring…" : root.hotkey-display;
                            font-size: 13px;
                            color: root.hotkey-available ? Palette.foreground : Palette.foreground.transparentize(50%);
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: "Configure Shortcut";
                        enabled: root.hotkey-available && !root.hotkey-configuring;
                        clicked => { root.configure-hotkey(); }
                    }
                    Button {
                        text: "Refresh";
                        enabled: !root.hotkey-configuring;
                        clicked => { root.refresh-hotkeys(); }
                    }
                }
                if root.hotkey-status != "" && !root.hotkey-configuring: Text {
                    text: root.hotkey-status;
                    font-size: 11px;
                    color: Palette.foreground.transparentize(40%);
                    wrap: word-wrap;
                }
            }
            // Non-Linux: editable LineEdit (Windows native)
            if !root.is-linux: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "Toggle key:"; vertical-alignment: center; font-size: 13px; }
                    LineEdit {
                        width: 140px;
                        text: root.toggle-key;
                        edited => { root.toggle-key = self.text; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: "Refresh Hotkeys";
                        clicked => { root.refresh-hotkeys(); }
                    }
                }
            }
        }
    }
}

export component InExAppPage inherits VerticalLayout {
    in-out property <bool> is-all-windows: false;
    in-out property <bool> is-include-window: true;
    in-out property <bool> is-exclude-window: false;
    in-out property <string> include-windows: "chrome.exe, msedge.exe";
    in-out property <string> exclude-windows: "explorer.exe, cmd.exe";

    spacing: 12px;
    alignment: start;

    GroupBox {
        title: "Window Filtering";
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            CheckBox {
                text: "All Windows";
                checked: root.is-all-windows;
                toggled => { root.is-all-windows = self.checked; }
            }
            CheckBox {
                text: "Include Mode";
                checked: root.is-include-window;
                toggled => { root.is-include-window = self.checked; root.is-exclude-window = !self.checked; }
            }
            CheckBox {
                text: "Exclude Mode";
                checked: root.is-exclude-window;
                toggled => { root.is-exclude-window = self.checked; root.is-include-window = !self.checked; }
            }
        }
    }

    if root.is-include-window: GroupBox {
        title: "Included Windows (comma-separated)";
        TextEdit {
            height: 70px; // Capped text area size
            text: root.include-windows;
            edited => { root.include-windows = self.text; }
        }
    }

    if root.is-exclude-window: GroupBox {
        title: "Excluded Windows (comma-separated)";
        TextEdit {
            height: 70px;
            text: root.exclude-windows;
            edited => { root.exclude-windows = self.text; }
        }
    }
}


export component ScalingPage inherits VerticalLayout {
    in-out property <bool> is-allow-max-cpu-limit: false;
    in-out property <int> max-cpu-limit: 90;

    spacing: 12px;
    alignment: start;

    GroupBox {
        title: "CPU Management";
        VerticalLayout {
            spacing: 10px;
            CheckBox {
                text: "Enable CPU limit";
                checked: root.is-allow-max-cpu-limit;
                toggled => { root.is-allow-max-cpu-limit = self.checked; }
            }
            if root.is-allow-max-cpu-limit: HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text { text: "Max CPU (%):"; vertical-alignment: center; font-size: 13px; }
                SpinBox {
                    width: 100px;
                    value: root.max-cpu-limit;
                    minimum: 10;
                    maximum: 100;
                    edited => { root.max-cpu-limit = self.value; }
                }
            }
        }
    }
}

export component AboutPage inherits VerticalLayout {
    spacing: 12px;
    alignment: start;

    GroupBox {
        title: "About Porda AI";
        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Porda AI v3.0.0";
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "Real-time desktop privacy overlay powered by AI object detection.";
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}
